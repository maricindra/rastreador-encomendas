# Dependencies (heavy and generated by npm, each one installs its own on the machine)
/node_modules
/.pnp
.pnp.js

# Production build of Next.js (generated automatically when you run the build)
/.next/
/out/

# Production / Deploy
/build

# Error logs (generated by Node.js)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Local environment variables (where passwords, API keys and secrets that SHOULD NOT be in GitHub are stored)
.env
.env*.local

# Operating system files (like Thumbs.db on Windows or .DS_Store on Mac)
.DS_Store
Thumbs.db

# Local code editor settings (like VS Code)
.vscode/
.idea/

# Tests
/coverage
/playwright-report
/test-results
/blob-report
/playwright/.cache